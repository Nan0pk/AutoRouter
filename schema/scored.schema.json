{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Nan0pk/AutoRouter/schema/scored.schema.json",
  "title": "AutoRouter scored model table",
  "description": "Output of scripts/score_models.py: provenance-tracked capability evidence, evidence coverage, an explicit token-mix cost model, and tiers (null when evidence is insufficient).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "weights",
    "min_coverage",
    "provenance_summary",
    "cost_model",
    "models"
  ],
  "properties": {
    "schema": {
      "const": "schema/scored.schema.json"
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "min_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_hit_rate"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_hit_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "billing": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "cache_prices_estimated": {
          "type": "boolean"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "key",
          "tier",
          "tier_status",
          "capability",
          "coverage",
          "metrics_used",
          "evidence",
          "est_cost_per_request",
          "value"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "pattern": "^[^/]+/"
          },
          "tier": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "T5",
              null
            ]
          },
          "tier_status": {
            "type": "string",
            "enum": [
              "ok",
              "insufficient evidence",
              "insufficient verified evidence"
            ]
          },
          "tier_reason": {
            "type": "string"
          },
          "capability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metrics_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics_missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source",
                "source_kind",
                "benchmark_version",
                "collected_on",
                "conditions",
                "provenance_status"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "normalised": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_kind": {
                  "type": "string",
                  "enum": [
                    "independent",
                    "aggregate",
                    "lab_card"
                  ]
                },
                "benchmark_version": {
                  "type": "string",
                  "minLength": 1
                },
                "collected_on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "conditions": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                },
                "provenance_status": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "unverified",
                    "estimated"
                  ]
                },
                "source_url": {
                  "type": "string"
                },
                "archive_url": {
                  "type": "string"
                },
                "derivation": {
                  "type": "string"
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "req_per_month": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "monthly_limit_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "input_cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "output_cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cache_read_cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cache_write_cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "est_cost_per_request": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "capacity_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          },
          "verified_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verified": {
                "type": "integer"
              },
              "unverified": {
                "type": "integer"
              },
              "estimated": {
                "type": "integer"
              }
            }
          },
          "cache_price_source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "require_verified": {
      "type": "boolean"
    },
    "provenance_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "verified",
        "unverified",
        "estimated",
        "note"
      ],
      "properties": {
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "estimated": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
